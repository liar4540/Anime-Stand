end

local function findImport(name)
	for _, inst in workspace:GetChildren() do
		if inst.Name == name and inst:FindFirstChild("Root", true) then
			return inst
		end
	end
	return nil
end

local report = {}
for name, st in DATA do
	local src = findImport(name)
	if not src then
		table.insert(report, name .. ": not imported (skipped)")
		continue
	end
	local parts, count = {}, 0
	for _, d in src:GetDescendants() do
		if d:IsA("MeshPart") and st.parts[d.Name] then
			parts[d.Name] = d
			count += 1
		end
	end
	local root = parts.Root
	local origin = root.Position - map(st.parts.Root.bbox_center)
	local maxErr = 0
	for pn, mp in parts do
		maxErr = math.max(maxErr, (mp.Position - (origin + map(st.parts[pn].bbox_center))).Magnitude)
	end

	local model = Instance.new("Model")
	model.Name = name
	for pn, mp in parts do
		local info = st.parts[pn]
		for _, c in mp:GetChildren() do
			if c:IsA("JointInstance") or c:IsA("WeldConstraint") then
				c:Destroy()
			end
		end
		mp.Anchored = false
		mp.CanCollide = false
		mp.CanTouch = false
		mp.CanQuery = false
		mp.Massless = true
		if info.glow then
			mp.Material = Enum.Material.Neon
			mp.Color = Color3.fromHex(info.color)
			mp.CastShadow = false
		else
			mp.Color = Color3.new(1, 1, 1)
		end
		if table.find(info.flags, "water") then
			mp.Transparency = 0.3
		end
		mp.Parent = model
	end
	root.Transparency = 1
	root.Massless = false

	for pn, mp in parts do
		local info = st.parts[pn]
		local p0 = info.parent and parts[info.parent]
		if p0 then
			local pivot = CFrame.new(origin + map(info.pivot))
			local m = Instance.new("Motor6D")
			m.Name = pn
			m.Part0 = p0
			m.Part1 = mp
			m.C0 = p0.CFrame:ToObjectSpace(pivot)
			m.C1 = mp.CFrame:ToObjectSpace(pivot)
			m.Parent = mp
		end
	end
	model.PrimaryPart = root
	model:SetAttribute("StandId", name)
	local old = folder:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	model.Parent = folder
	src:Destroy()
	table.insert(report, string.format("%s: %d parts rigged, import fit error %.3f studs", name, count, maxErr))
end
print(table.concat(report, "\n"))
return table.concat(report, "\n")
